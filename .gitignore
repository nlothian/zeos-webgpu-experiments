# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Runs and journals -- regenerable, and large. A case's `events.jsonl` is the
# exception: it is scripted *input* to a run rather than output from one.
*.jsonl
!**/cases/**/events.jsonl
# Test fixtures carry their own event schedules and must travel with the repository.
!tests/fixtures/**/*.jsonl
# The browser demo's evidence: journals of model runs cited by its write-up.
!demo/coop-count-web/docs/evidence/*.jsonl

# A demo's run output, at any depth. The demo's own .gitignore covers it for
# git, but the sdist builder reads only this file, so run artifacts reach the
# tarball unless the root list names them too.
runs/

# A demo's or package's npm install, for the same reason: the sdist builder reads only
# this file. No trailing slash, so a symlink to a shared install matches too.
node_modules

# Model exports and downloads, gigabytes each: a package's or demo's own `models/`,
# often a symlink to a shared copy (no trailing slash, so the symlink matches too).
# Covers checkouts made before the browser layer moved out of demo/coop-count-web,
# whose `demo/coop-count-web/models` is still on disk.
/demo/*/models
/packages/*/models

# Editor state -- personal to a checkout, never shared
.vscode/
.idea/

# Secrets -- never committed, at any depth
.env
